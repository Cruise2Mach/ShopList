<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="ShopList.Views.ListsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Your lists">

    <Grid
        Padding="32"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        RowSpacing="20"
        MaximumWidthRequest="720"
        HorizontalOptions="Fill">

        <Label
            Grid.Row="0"
            Text="Your lists"
            FontSize="32"
            FontAttributes="Bold" />

        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">

            <Entry
                x:Name="NewListNameEntry"
                Grid.Column="0"
                Placeholder="New list name"
                MaxLength="100"
                ReturnType="Go"
                Completed="OnNewListNameCompleted"
                ClearButtonVisibility="WhileEditing" />

            <Button
                x:Name="CreateListButton"
                Grid.Column="1"
                Text="Create list"
                Clicked="OnCreateListClicked" />

        </Grid>

        <VerticalStackLayout
            Grid.Row="2"
            Spacing="10">

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsVisible="False"
                IsRunning="False"
                HorizontalOptions="Center" />

            <Label
                x:Name="MessageLabel"
                IsVisible="False"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <Grid Grid.Row="3">

            <CollectionView
                x:Name="ListsCollectionView"
                IsVisible="False"
                SelectionMode="Single"
                SelectionChanged="OnListSelectionChanged">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="16"
                            Margin="0,0,0,10"
                            Stroke="{AppThemeBinding Light=#D8D8D8, Dark=#444444}"
                            StrokeShape="RoundRectangle 8">

                            <Label
                                Text="{Binding Name}"
                                FontSize="18"
                                FontAttributes="Bold" />

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Label
                x:Name="EmptyStateLabel"
                Text="You don't have any lists yet. Create your first one above."
                IsVisible="False"
                FontSize="16"
                Opacity="0.7"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

        </Grid>

        <Button
            x:Name="SignOutButton"
            Grid.Row="4"
            Text="Sign out"
            Clicked="OnSignOutClicked"
            HorizontalOptions="Start" />

    </Grid>
</ContentPage>
